<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <!-- Dimensions from course-kit v1-w08 models/course_ackermann/model.sdf.
       SI units; x forward, y left, z up. Joint origins are parent-relative. -->
  <xacro:arg name="wheel_base" default="0.8"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheel_base" value="$(arg wheel_base)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>

  <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="wheel_black"><color rgba="0.04 0.04 0.04 1"/></material>
  <material name="sensor_orange"><color rgba="1 0.5 0 1"/></material>

  <link name="base_link">
    <inertial>
      <mass value="12"/>
      <inertia ixx="0.55" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.40"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="1.05 0.52 0.22"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="1.05 0.52 0.22"/></geometry>
    </collision>
  </link>

  <link name="front_left_knuckle">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_left_knuckle"/>
    <origin xyz="${wheel_base / 2} ${track / 2} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25" velocity="1"/>
  </joint>
  <link name="front_right_knuckle">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_right_knuckle"/>
    <origin xyz="${wheel_base / 2} ${-track / 2} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.55" upper="0.55" effort="25" velocity="1"/>
  </joint>

  <!-- Rotate cylinder geometry, not the link frame: wheel axes remain +Y. -->
  <link name="front_left_wheel">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/><child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="front_right_wheel">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/><child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_left_wheel">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="${-wheel_base / 2} ${track / 2} 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_wheel">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="${pi / 2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="${-wheel_base / 2} ${-track / 2} 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- The SDF specifies sensor frames but no visible sensor housings.
       Small boxes below visualize these frames; they are not Gazebo sensors. -->
  <link name="camera_link">
    <inertial>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" ixy="0" ixz="0" iyy="0.000333333333" iyz="0" izz="0.000333333333"/>
    </inertial>
    <visual><geometry><box size="0.06 0.04 0.04"/></geometry><material name="sensor_orange"/></visual>
    <collision><geometry><box size="0.06 0.04 0.04"/></geometry></collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
  <link name="lidar_link">
    <inertial>
      <mass value="0.033333333333"/>
      <inertia ixx="0.000333333333" ixy="0" ixz="0" iyy="0.000333333333" iyz="0" izz="0.000333333333"/>
    </inertial>
    <visual><geometry><cylinder radius="0.04" length="0.04"/></geometry><material name="sensor_orange"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.04"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.033333333334"/>
      <inertia ixx="0.000333333334" ixy="0" ixz="0" iyy="0.000333333334" iyz="0" izz="0.000333333334"/>
    </inertial>
    <visual><geometry><box size="0.025 0.025 0.015"/></geometry><material name="sensor_orange"/></visual>
    <collision><geometry><box size="0.025 0.025 0.015"/></geometry></collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0.28 0 0.38"/>
  </joint>
</robot>
